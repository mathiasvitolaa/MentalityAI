# === Gemini API ===
# Obtén tu API Key real en https://aistudio.google.com/apikey
# ¡NUNCA subas este archivo con la clave real a un repositorio publico!
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# === Base de datos PostgreSQL ===
DATABASE_URL=postgresql+psycopg2://studyai:studyai@localhost:5432/studyai

# === Seguridad / JWT ===
JWT_SECRET_KEY=cambia-esta-clave-por-una-secreta-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === CORS ===
FRONTEND_ORIGIN=http://localhost:3000
